node_modules/
dist/
.wrangler/
.dev.vars
*.env
.md/

# Compiled output is never versioned: wrangler deploys src/index.ts directly.
# Versioning these produces stale, divergent snapshots of the real source.
packages/*/src/**/*.js

# Python build and test artifacts (sdk-python)
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
build/

# Stray npm lockfile: this is a pnpm workspace (see pnpm-lock.yaml at the root).
package-lock.json
